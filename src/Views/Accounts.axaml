<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:vm="using:SourceGit.ViewModels"
                    x:Class="SourceGit.Views.Accounts"
                    x:DataType="vm:Accounts"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.Accounts}"
                    Width="700" Height="500"
                    MinWidth="500" MinHeight="350"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- TitleBar (close button only, like Fork) -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              PointerPressed="BeginMoveWindow"/>
      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <TextBlock Grid.Row="1" Classes="bold" Margin="20,4,20,8"
               FontSize="14"
               Text="{DynamicResource Text.Accounts}"/>

    <!-- Body -->
    <Border Grid.Row="2" Margin="16,0" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border1}">
      <Grid ColumnDefinitions="220,Auto,*">
        <!-- Accounts list + add/remove bar -->
        <Grid Grid.Column="0" RowDefinitions="*,Auto">
          <ListBox Grid.Row="0" x:Name="AccountList"
                   Background="{DynamicResource Brush.Contents}"
                   BorderThickness="0"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding Selected, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:Account">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,4">
                  <Path Width="20" Height="20" Data="{Binding Icon}" Fill="{DynamicResource Brush.FG2}" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Provider}"/>
                    <TextBlock Text="{Binding Username}" Foreground="{DynamicResource Brush.FG2}"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="1" Height="24"
                  BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border1}"
                  Background="{DynamicResource Brush.Contents}">
            <StackPanel Orientation="Horizontal">
              <Button Classes="icon_button" Width="24" Height="24" ToolTip.Tip="+" Click="OnAddAccount">
                <Path Width="10" Height="10" Data="{StaticResource Icons.Plus}"/>
              </Button>
              <Button Classes="icon_button" Width="24" Height="24" ToolTip.Tip="-" Click="OnRemoveAccount"
                      IsEnabled="{Binding #AccountList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Path Width="10" Height="10" Data="{StaticResource Icons.Minus}"/>
              </Button>
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Border1}"/>

        <!-- Detail pane -->
        <Grid Grid.Column="2" Background="{DynamicResource Brush.Window}">
          <!-- Empty state -->
          <Path Width="64" Height="64"
                Fill="{DynamicResource Brush.FG2}" Opacity="0.4"
                Stretch="Uniform"
                Data="{StaticResource Icons.User}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"/>

          <Grid RowDefinitions="Auto,*"
                DataContext="{Binding Selected}"
                IsVisible="{Binding Selected, Source={x:Static vm:Accounts.Instance}, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="20,12,12,12">
              <Border Width="32" Height="32" Background="{DynamicResource Brush.Contents}" CornerRadius="2" ClipToBounds="True">
                <Panel>
                  <Path Width="18" Height="18" Data="{StaticResource Icons.User}" Fill="{DynamicResource Brush.FG2}"/>
                  <Image x:DataType="vm:Account" Source="{Binding Avatar}" Stretch="UniformToFill"/>
                </Panel>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:DataType="vm:Account" Text="{Binding Username}"/>
                <TextBlock x:DataType="vm:Account" Text="{Binding Url}"
                           Foreground="{DynamicResource Brush.Link}" TextDecorations="Underline"
                           Cursor="Hand" PointerPressed="OnOpenAccountUrl"/>
              </StackPanel>
            </StackPanel>

            <TabControl Grid.Row="1">
              <TabItem>
                <TabItem.Header>
                  <TextBlock Classes="tab_header" Text="Account"/>
                </TabItem.Header>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="20,16">
                  <TextBlock Grid.Row="0" Text="Server Type:" HorizontalAlignment="Right" Margin="0,0,8,8"/>
                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                    <Path x:DataType="vm:Account" Width="14" Height="14" Data="{Binding Icon}" Fill="{DynamicResource Brush.FG2}"/>
                    <TextBlock x:DataType="vm:Account" Text="{Binding Provider}"/>
                  </StackPanel>

                  <TextBlock Grid.Row="1" Text="Authentication Type:" HorizontalAlignment="Right" Margin="0,0,8,8"/>
                  <TextBlock x:DataType="vm:Account" Grid.Row="1" Grid.Column="1" Text="{Binding AuthType}" Margin="0,0,0,8"/>

                  <TextBlock Grid.Row="2" Text="Username:" HorizontalAlignment="Right" Margin="0,0,8,8"/>
                  <TextBlock x:DataType="vm:Account" Grid.Row="2" Grid.Column="1" Text="{Binding Username}" Margin="0,0,0,8"/>

                  <TextBlock Grid.Row="3" Text="Status:" HorizontalAlignment="Right" Margin="0,0,8,8"/>
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <Ellipse x:DataType="vm:Account" Width="10" Height="10" Fill="{Binding StatusBrush}"/>
                    <TextBlock x:DataType="vm:Account" Text="{Binding StatusText}"/>
                  </StackPanel>

                  <Button Grid.Row="4" Grid.Column="1" Classes="flat" Content="Update token..." HorizontalAlignment="Left" Margin="0,0,0,8" Click="OnUpdateToken"/>
                  <CheckBox x:DataType="vm:Account" Grid.Row="5" Grid.Column="1" Content="Enable Notifications" IsChecked="{Binding EnableNotifications, Mode=TwoWay}"/>
                </Grid>
              </TabItem>

              <TabItem>
                <TabItem.Header>
                  <TextBlock Classes="tab_header" Text="Repositories"/>
                </TabItem.Header>
                <Grid>
                  <!-- Loading state -->
                  <StackPanel x:DataType="vm:Account" IsVisible="{Binding IsLoadingRepositories}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Path Width="64" Height="64" Data="{StaticResource Icons.User}" Fill="{DynamicResource Brush.FG2}" Opacity="0.4" Stretch="Uniform"/>
                    <TextBlock Text="Loading repositories..." Foreground="{DynamicResource Brush.FG2}" HorizontalAlignment="Center"/>
                  </StackPanel>

                  <Grid x:DataType="vm:Account" RowDefinitions="Auto,*" Margin="8"
                        IsVisible="{Binding !IsLoadingRepositories}">
                    <TextBox Grid.Row="0" Height="26" Watermark="Filter" Text="{Binding Filter, Mode=TwoWay}">
                      <TextBox.InnerLeftContent>
                        <Path Width="14" Height="14" Margin="6,0,0,0" Data="{StaticResource Icons.Search}" Fill="{DynamicResource Brush.FG2}"/>
                      </TextBox.InnerLeftContent>
                    </TextBox>
                    <ScrollViewer Grid.Row="1" Margin="0,4,0,0">
                      <ItemsControl ItemsSource="{Binding FilteredGroups}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:AccountRepoGroup">
                            <StackPanel>
                              <TextBlock Classes="bold" Margin="4,8,0,4" Text="{Binding Owner}"/>
                              <ItemsControl ItemsSource="{Binding Repositories}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:AccountRepo">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Height="24" Margin="8,0">
                                      <Path Grid.Column="0" Width="12" Height="12" Margin="0,0,8,0" Data="{Binding Icon}" Fill="{DynamicResource Brush.FG2}"/>
                                      <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                      <Button Grid.Column="2" Classes="icon_button" Width="22" Height="22" ToolTip.Tip="Clone" Click="OnCloneRepo">
                                        <Path Width="12" Height="12" Data="{StaticResource Icons.Fetch}"/>
                                      </Button>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <Button Grid.Row="3" Classes="flat" Margin="16,12,16,12" HorizontalAlignment="Right"
            Content="{DynamicResource Text.Close}"
            Click="OnClose"/>
  </Grid>
</v:ChromelessWindow>
